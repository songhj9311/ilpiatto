# /etc/nginx/sites-available/ilpiatto
# 홍보 사이트(/)는 누구나, 관리자 사이트(/admin/)와 API는 로그인한 사람만

# 접속 기록 형식: 시각 | IP | 로그인ID | 요청 | 상태 | 크기 | 처리초 | 이전페이지 | 브라우저
log_format ilpiato '$time_local | $remote_addr | $remote_user | "$request" | $status | '
                   '$body_bytes_sent | ${request_time}s | "$http_referer" | "$http_user_agent"';

server {
    listen 8088;
    server_name _;

    # 로그는 /var/log/ilpiatto 에 모으고, 일주일마다 log_backup.py가 백업 후 비운다
    access_log /var/log/ilpiatto/nginx-access.log ilpiato;
    error_log  /var/log/ilpiatto/nginx-error.log warn;

    # 홍보 사이트
    root  /opt/app/promo;
    index index.html;
    location / {
        try_files $uri $uri/ =404;
    }
    location /images/ {
        expires 7d;
        access_log off;   # 사진 요청은 수가 많아 기록하지 않음
    }

    # 관리자 사이트 (메뉴 가격 관리)
    location /admin/ {
        auth_basic           "Ilpiatto Admin";
        auth_basic_user_file /etc/nginx/.htpasswd;
        alias /opt/app/web/;
        index index.html;
    }

    # API (관리자 화면에서만 사용)
    location /py/ {
        auth_basic           "Ilpiatto Admin";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location /java/ {
        auth_basic           "Ilpiatto Admin";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://127.0.0.1:8080/java/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
